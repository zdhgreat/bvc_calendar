# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=calendar_user
POSTGRES_PASSWORD=calendar_password
POSTGRES_DB=financial_calendar

# Finnhub (EN events). Register at https://finnhub.io
FINNHUB_API_KEY=TODO

# Optional shared secret for the data feed (/api/feed, /api/event).
# Unset = open. Set it when a consumer (agent/bbs) calls over a network.
# FEED_TOKEN=

# Post-render config (each event's `post.category` / `post.tags`).
# POST_CATEGORIES is a JSON map {kind: bbs-go category name}; defaults:
#   {"economic":"宏观经济","earnings":"财报","corporate":"公司事件","ipo":"IPO"}
# Override names to match categories that actually exist in bbs-go.
# POST_CATEGORIES=
# POST_DEFAULT_TAG=投研日历
